# Warble API key (required). Any non-/me call activates the sim clock
# irreversibly — see CLAUDE.md before running the collector.
WARBLE_API_KEY=

# Async-driver DB URL. Defaults to local SQLite if unset; use
# postgresql+asyncpg://... for Supabase/Postgres.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname

# Optional: enables the LLM narration path in the agent chat. Without it,
# the agent falls back to deterministic, evidence-grounded answers.
ANTHROPIC_API_KEY=
